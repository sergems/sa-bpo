# Calculator lead delivery — enter actual values only in the deployment's private environment.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Optional; defaults to SMTP_USER. Must be an address permitted by the mailbox provider.
SMTP_FROM=
# Set true only when the application runs behind a trusted proxy that supplies client IPs.
TRUST_PROXY=false
