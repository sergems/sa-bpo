# Cloudflare Email Service REST API used by the Pages Function and local preview.
CF_ACCOUNT_ID=
# Create a Cloudflare API token scoped to Email Sending: Edit. Never commit the token.
CF_EMAIL_API_TOKEN=
# Must use the verified sender domain onboarded for Cloudflare Email Sending.
CF_EMAIL_FROM=calculator@sa-bpo.co.za
# Set true only for the separate Express preview when it is behind a trusted proxy.
TRUST_PROXY=false
